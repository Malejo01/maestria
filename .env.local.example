# ==============================================================================
# MaestrIA — Configuración de Variables de Entorno (.env.local.example)
# ==============================================================================
# Copia este archivo a ".env.local" y rellena los valores reales para iniciar
# el entorno de desarrollo local.
# ==============================================================================

# ------------------------------------------------------------------------------
# [Base de Datos]
# Conexión principal de base de datos relacional (PostgreSQL en Neon u homólogo)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://your_database_user:your_database_password@your_database_host/your_database_name?sslmode=require

# Endpoint DIRECTO (sin "-pooler" en el host). pg_dump no puede pasar por
# PgBouncer, así que el script de backup usa este. Ver docs/backups.md.
DATABASE_URL_UNPOOLED=postgres://your_database_user:your_database_password@your_database_host_sin_pooler/your_database_name?sslmode=require

# ID del proyecto en Neon. Es lo que hay que tipear para confirmar una
# migración contra producción (scripts/lib/db-target.ts).
NEON_PROJECT_ID=your_neon_project_id

# Para apuntar a staging, creá un .env.staging.local con este mismo formato y
# corré los scripts con --env=staging. Ver docs/staging.md.

# ------------------------------------------------------------------------------
# [NextAuth.js / Autenticación]
# Configuración del motor de inicio de sesión Auth.js v5
# ------------------------------------------------------------------------------
# Secreto para firmar y encriptar cookies de sesión (generar con: openssl rand -base64 33)
AUTH_SECRET=your_auth_secret_token_here
NEXTAUTH_SECRET=your_auth_secret_token_here

# URL base del servidor de autenticación (requerido para producción, opcional en dev local)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Proveedor OAuth de Google (Credenciales obtenidas en Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# [IA / Gemini]
# Proveedor del motor generador de cuestionarios y retroalimentación inteligente
# ------------------------------------------------------------------------------
# Clave API de Google AI Studio (Gemini API)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# [Límites de IA y costo]
# Protegen la cuenta de Gemini de picos inesperados. Todas tienen default:
# la app arranca sin configurarlas.
# ------------------------------------------------------------------------------
# Tope de gasto estimado por día (USD) de TODO el proyecto. Superado el tope,
# los endpoints de IA responden 503 hasta que la ventana de 24 h se libere.
# Default: 15
AI_DAILY_BUDGET_USD=15

# Sub-tope (USD por día) de lo que pueden gastar los invitados, DENTRO del tope
# de arriba: su gasto suma al total, pero se cortan al llegar a este número,
# así un abuso anónimo nunca agota el global. Superado, los invitados reciben
# 429 con un mensaje que los manda a ingresar con Google, y queda un evento en
# Sentry con el tag ai_budget_pool=guest.
# Default: 3
AI_GUEST_DAILY_BUDGET_USD=3

# Allowlist de emails, separados por coma. Saltean el límite por usuario (NO el
# tope de presupuesto) y son los únicos que ven /admin/ai-usage.
ADMIN_EMAILS=tu_email@gmail.com

# ------------------------------------------------------------------------------
# [Sentry / Monitoreo de errores]
# Sin DSN el SDK queda inerte y la app funciona igual: en local no hace falta.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXXXX

# Sólo para el build: habilitan la subida de source maps. Sin ellas el build
# funciona, pero los stack traces de producción quedan ilegibles.
SENTRY_ORG=tu-organizacion
SENTRY_PROJECT=maestria
SENTRY_AUTH_TOKEN=sntrys_xxxxx

# ------------------------------------------------------------------------------
# [Backups]
# Estas NO van en .env.local: viven en GitHub Secrets, porque el backup corre
# en Actions (pg_dump tiene que ser >= 17 y ninguna laptop del equipo tiene
# cliente Postgres). Se listan acá sólo como referencia. Ver docs/backups.md.
# ------------------------------------------------------------------------------
# Passphrase del cifrado gpg simétrico. Si se pierde, los backups son
# ilegibles para siempre — guardala TAMBIÉN fuera de GitHub (ver docs/backups.md §2.3).
# BACKUP_GPG_PASSPHRASE=$(openssl rand -base64 48)

# Token del Blob store de Vercel donde se suben los dumps cifrados.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# ------------------------------------------------------------------------------
# [Configuración General]
# ------------------------------------------------------------------------------
# Entorno de ejecución (development, production)
NODE_ENV=development
