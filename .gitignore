# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/
next.user-config.*

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store

# Build artifacts. El .tsbuildinfo es la caché incremental de tsc: cambia en cada
# build, así que trackeado ensucia todos los diffs y es conflicto garantizado
# cuando dos ramas tocan el proyecto en paralelo.
*.tsbuildinfo
coverage/
# clerk configuration (can include secrets)
/.clerk/

# Backups de scripts/fix-perfiles-*.ts. Contienen ids de usuarios reales y son
# el punto de restauración de una corrida puntual: no tienen valor en el repo y
# sí lo tienen en la máquina donde se corrió el script.
scripts/backups/

# Volcados de `gh run view --log`. Son artefactos de diagnóstico de CI:
# pesados, en UTF-16 y sin valor histórico una vez leídos.
run.log
*.run.log

# Reportes de los agentes de contenido: artefactos regenerables.
# El set de calibracion (qa-fixtures/) SI se commitea: es el contrato de la rubrica.
qa-reports/
